# Observatory Environment Configuration
# Copy to .env and fill in your values

DATABASE_URL=postgresql+asyncpg://observatory:observatory_dev@localhost:5432/observatory
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Auth
JWT_SECRET=change-this-to-a-real-secret

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=observatory
S3_SECRET_KEY=observatory_dev
S3_BUCKET=observatory
